<?php
declare(strict_types=1);
/* Re-install script generated by the backup system. Upload the extracted backup to the new host, open this file in the browser. It deletes itself on success. */
const KEY_HASH = '__KEYHASH__';
const SEP = "\n-- ~~STMT~~\n";
$root = __DIR__; $sqlF = $root . '/data/_backup/database.sql'; $manF = $root . '/data/_backup/manifest.json';
$man = json_decode((string)@file_get_contents($manF), true) ?: [];
$driver = ($man['driver'] ?? 'mysql') === 'sqlite' ? 'sqlite' : 'mysql';
header('Content-Type: text/html; charset=utf-8'); header('Cache-Control: no-store'); header('X-Robots-Tag: noindex');
$h = fn($s) => htmlspecialchars((string)$s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$v = $_POST; $err = ''; $done = false; $diag = [];
if (PHP_VERSION_ID < 80100) $diag[] = 'يتطلب PHP 8.1+ (الحالي ' . PHP_VERSION . ')';
foreach (['pdo', 'pdo_' . $driver, 'mbstring', 'json'] as $x) if (!extension_loaded($x)) $diag[] = "الامتداد $x غير مفعّل";
if (!is_file($sqlF)) $diag[] = 'data/_backup/database.sql غير موجود — فُكّ الأرشيف كاملاً (مع مجلد data) داخل public_html';
if (!is_writable($root)) $diag[] = 'مجلد الموقع غير قابل للكتابة (لكتابة config.php)';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !$diag) {
    if (!hash_equals(KEY_HASH, hash('sha256', trim((string)($v['key'] ?? ''))))) { sleep(2); $err = 'مفتاح الاستعادة غير صحيح (يظهر في لوحة التحكم بجانب النسخة).'; }
    else try {
        if ($driver === 'mysql') {
            $pdo = new PDO('mysql:host=' . trim((string)$v['db_host']) . ';dbname=' . trim((string)$v['db_name']) . ';charset=utf8mb4', trim((string)$v['db_user']), (string)($v['db_pass'] ?? ''), [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
            if ($pdo->query('SHOW TABLES')->fetchAll() && empty($v['overwrite'])) throw new RuntimeException('القاعدة ليست فارغة. استخدم قاعدة جديدة أو فعّل «استبدال الجداول الموجودة».');
        } else $pdo = new PDO('sqlite:' . $root . '/data/site.sqlite', null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
        $n = 0;
        foreach (explode(SEP, (string)file_get_contents($sqlF)) as $st) { $st = trim($st); if ($st !== '') { $pdo->exec($st); $n++; } }
        $conf = is_file($root . '/config.php') ? (array)(require $root . '/config.php') : [];
        $conf['db_driver'] = $driver;
        if ($driver === 'mysql') { $conf['db_host'] = trim((string)$v['db_host']); $conf['db_name'] = trim((string)$v['db_name']); $conf['db_user'] = trim((string)$v['db_user']); $conf['db_pass'] = (string)($v['db_pass'] ?? ''); }
        else $conf['db_sqlite'] = $root . '/data/site.sqlite';
        if (trim((string)($v['site_url'] ?? '')) !== '') $conf['site_url'] = rtrim(trim((string)$v['site_url']), '/');
        unset($conf['base_path']);
        if (file_put_contents($root . '/config.php', "<?php\n// Rewritten by restore.php\nreturn " . var_export($conf, true) . ";\n", LOCK_EX) === false) throw new RuntimeException('تعذّر كتابة config.php');
        @chmod($root . '/config.php', 0640); @file_put_contents($root . '/install.lock', gmdate('c'));
        @unlink($sqlF); @unlink($manF); @rmdir($root . '/data/_backup'); @unlink(__FILE__);
        $done = true;
    } catch (Throwable $e) { $err = 'فشلت الاستعادة: ' . $e->getMessage(); }
}
?><!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>استعادة الموقع</title>
<style>body{font-family:system-ui,Tahoma,sans-serif;background:#0a0a10;color:#f2efe4;display:grid;place-items:center;min-height:100vh;margin:0;padding:16px}.b{background:#14141c;border:1px solid #262631;border-radius:18px;padding:24px;width:100%;max-width:460px}
label{display:block;margin:10px 0;font-size:.9rem}input,select{width:100%;box-sizing:border-box;margin-top:4px;padding:9px;border-radius:10px;border:1px solid #262631;background:#0a0a10;color:inherit}button{margin-top:14px;padding:10px 26px;border:0;border-radius:99px;background:#e8b923;color:#111;font-weight:700;cursor:pointer}.n{padding:10px;border-radius:10px;margin:10px 0}.bad{background:#3a1b1b;color:#ff8a80}.ok{background:#12301f;color:#6fd49a}</style></head><body><div class="b">
<h2>استعادة الموقع على استضافة جديدة</h2>
<?php foreach ($diag as $d): ?><div class="n bad">⚠ <?= $h($d) ?></div><?php endforeach; ?>
<?php if ($err): ?><div class="n bad"><?= $h($err) ?></div><?php endif; ?>
<?php if ($done): ?><div class="n ok">تمت الاستعادة ✓ (<?= (int)$n ?> أمر). حُذف هذا السكربت وملفات الاستعادة تلقائياً.</div><p><a style="color:#e8b923" href="admin/">فتح لوحة التحكم</a></p>
<?php elseif (!$diag): ?><form method="post" autocomplete="off">
<label>مفتاح الاستعادة<input name="key" dir="ltr" required></label>
<?php if ($driver === 'mysql'): ?>
<label>مضيف القاعدة<input name="db_host" dir="ltr" value="<?= $h($v['db_host'] ?? 'localhost') ?>" required></label>
<label>اسم القاعدة<input name="db_name" dir="ltr" value="<?= $h($v['db_name'] ?? '') ?>" required></label>
<label>مستخدم القاعدة<input name="db_user" dir="ltr" value="<?= $h($v['db_user'] ?? '') ?>" required></label>
<label>كلمة مرور القاعدة<input name="db_pass" type="password" dir="ltr"></label>
<label><input type="checkbox" name="overwrite" value="1" style="width:auto"> استبدال الجداول الموجودة إن كانت القاعدة غير فارغة</label>
<?php endif; ?>
<label>رابط الموقع الجديد (اختياري، https://…)<input name="site_url" dir="ltr" value="<?= $h($v['site_url'] ?? '') ?>"></label>
<button type="submit">استعادة</button></form><?php endif; ?></div></body></html>
